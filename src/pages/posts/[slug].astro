---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => import.meta.env.DEV || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
---
<BlogLayout title={title} description={description}>
  <article class="post-page">
    <a class="back-link" href="/">All notes</a>
    <header class="post-header">
      <p class="kicker">{date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>
    <div class="post-content"><Content /></div>
    <footer class="post-tags">{tags.map((tag) => <span>#{tag}</span>)}</footer>
  </article>
</BlogLayout>
